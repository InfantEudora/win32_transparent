/*
    x = the token's row of the embedding table, dequantized: one invocation per value, one row
    of workgroups (gl_WorkGroupID.y) per token of the batch, token b's row going to x at b * dim.

    The table is 8-bit in a q40e8 model and 4-bit (or 8-bit) otherwise; the layouts are the ones
    llm_matvec_q4.comp and llm_matvec_q8.comp describe, read here one value at a time because a
    single row is a few KB and not worth a cleverer access pattern.
*/

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer TableValues { uint w[]; };
layout(std430, binding = 1) readonly buffer TableScales { float ws[]; };   //the same buffer
layout(std430, binding = 2) writeonly buffer Output { float x[]; };

#define MAX_TOKENS 32       //MAX_BATCH in LLMModel.h
uniform int tokens[MAX_TOKENS];
uniform int dim;
uniform int bits;       //4 or 8
uniform int gs;         //values per scale
uniform int s_offset;

void main(){
    int i = int(gl_GlobalInvocationID.x);
    if (i >= dim){
        return;
    }
    int b = int(gl_WorkGroupID.y);
    int e = tokens[b] * dim + i;    //the value's index in the whole table; < 2^31 for any vocab here
    float v;
    if (bits == 8){
        uint u = w[e >> 2];
        v = float(int(u << (24 - 8 * (e & 3))) >> 24);
    }else{
        int g = e / 32;
        int k = e % 32;
        int byte_index = g * 16 + (k & 15);
        uint byte_value = (w[byte_index >> 2] >> (8 * (byte_index & 3))) & 0xFFu;
        v = float(int(k < 16 ? (byte_value & 0x0Fu) : (byte_value >> 4)) - 8);
    }
    x[b * dim + i] = v * ws[s_offset + e / gs];
}
